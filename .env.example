# WebRAG uses a local Ollama server — no API keys needed.
#   ollama pull nomic-embed-text
#   ollama pull gemma4:31b-cloud      (cloud models need `ollama signin`)

# OLLAMA_HOST=127.0.0.1:11434
# WEBRAG_MODEL=gemma4:31b-cloud        # answers, follow-up rewriting, change summaries
# WEBRAG_EMBED_MODEL=nomic-embed-text  # semantic search
# WEBRAG_LLM=ollama                    # ollama | none  (none = show top passages only)
# WEBRAG_EMBED=ollama                  # ollama | none  (none = keyword search only)
# WEBRAG_DB=webrag.db
# WEBRAG_TOP_K=6
# WEBRAG_WATCH_MINUTES=0               # >0: the web server re-checks all pages on this interval
# WEBRAG_MAX_UPLOAD_MB=50              # size limit for uploaded PDF / Word / PowerPoint files
